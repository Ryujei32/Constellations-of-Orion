using System; // ⭐ FIX
using Microsoft.Xna.Framework;
using Terraria;
using Terraria.ID;
using Terraria.ModLoader;

namespace ConstellationsOfOrion.Content.Projectiles.Pets
{
	public class StarryPrincePet : ModProjectile
	{
		public override void SetStaticDefaults()
		{
			DisplayName.SetDefault("Starry Prince");

			Main.projFrames[Projectile.type] = 5;
			Main.projPet[Projectile.type] = true;
		}

		public override void SetDefaults()
		{
			Projectile.width = 32;
			Projectile.height = 32;

			Projectile.tileCollide = true;
			Projectile.ignoreWater = true;

			Projectile.penetrate = -1;

			Projectile.netImportant = true;
		}

		public override void AI()
		{
			Player player = Main.player[Projectile.owner];

			if (!player.active)
			{
				Projectile.Kill();
				return;
			}

			if (player.dead)
			{
				player.ClearBuff(ModContent.BuffType<Content.Buffs.StarryPrinceBuff>());
			}

			if (player.HasBuff(ModContent.BuffType<Content.Buffs.StarryPrinceBuff>()))
			{
				Projectile.timeLeft = 2;
			}

			// ⭐ TELEPORT IF TOO FAR
			float distance = Vector2.Distance(Projectile.Center, player.Center);
			if (distance > 1200f)
			{
				Projectile.Center = player.Center;
				Projectile.velocity *= 0.1f;
			}

			// ⭐ GRAVITY
			Projectile.velocity.Y += 0.4f;
			if (Projectile.velocity.Y > 10f)
				Projectile.velocity.Y = 10f;

			// ⭐ MOVE TOWARD PLAYER
			float speed = 2.5f;

			if (Projectile.Center.X < player.Center.X - 40f)
			{
				Projectile.velocity.X = speed;
			}
			else if (Projectile.Center.X > player.Center.X + 40f)
			{
				Projectile.velocity.X = -speed;
			}
			else
			{
				Projectile.velocity.X *= 0.9f;
			}

			// ⭐ JUMP LIKE A SLIME
			if (Projectile.velocity.Y == 0f)
			{
				if (Math.Abs(Projectile.velocity.X) > 0.5f)
				{
					Projectile.velocity.Y = -6f;
				}
			}

			// ⭐ FACE DIRECTION
			if (Projectile.velocity.X > 0.1f)
				Projectile.spriteDirection = 1;
			else if (Projectile.velocity.X < -0.1f)
				Projectile.spriteDirection = -1;

			// ⭐ ANIMATION
			Projectile.frameCounter++;

			if (Projectile.frameCounter >= 6)
			{
				Projectile.frameCounter = 0;
				Projectile.frame++;

				if (Projectile.frame >= 5)
					Projectile.frame = 0;
			}
		}
	}
}
